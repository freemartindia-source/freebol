{
  "rules": {
    ".read": false,
    ".write": false,
    "messages": {
      "$room": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','name','type','text','ts'])",
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "type": { ".validate": "newData.isString() && (newData.val() === 'msg' || newData.val() === 'buzz' || newData.val() === 'img' || newData.val() === 'file')" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "ts": { ".validate": "newData.isNumber()" },
          "av": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "lang": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "img": { ".validate": "newData.isString() && newData.val().length <= 65000 && newData.val().matches(/^data:image\\/jpeg;base64,.*/)" },
          "fileUrl": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.*/)" },
          "filePath": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "fileName": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "mime": { ".validate": "newData.isString() && newData.val().length <= 150" },
          "size": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 26214400" },
          "$other": { ".validate": false }
        }
      }
    },
    "presence": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','name','st','lang','av'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "st": { ".validate": "newData.val() === 'on' || newData.val() === 'away' || newData.val() === 'busy' || newData.val() === 'inv'" },
          "msg": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "lang": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "av": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "cc": { ".validate": "newData.isString() && newData.val().length <= 4" },
          "typ": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "roomsmeta": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (!data.exists() || data.child('by').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name','by'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24" },
        "icon": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "by": { ".validate": "newData.val() === auth.uid" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "dm": {
      "$pair": {
        ".read": "auth != null && $pair.matches('^' + auth.uid + '_.*|.*_' + auth.uid + '$')",
        "$messageId": {
          ".write": "auth != null && $pair.matches('^' + auth.uid + '_.*|.*_' + auth.uid + '$') && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','name','type','text','ts'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "type": { ".validate": "newData.isString() && (newData.val() === 'msg' || newData.val() === 'buzz' || newData.val() === 'img' || newData.val() === 'file')" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "ts": { ".validate": "newData.isNumber()" },
          "av": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "lang": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "img": { ".validate": "newData.isString() && newData.val().length <= 65000 && newData.val().matches(/^data:image\\/jpeg;base64,.*/)" },
          "fileUrl": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.*/)" },
          "filePath": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "fileName": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "mime": { ".validate": "newData.isString() && newData.val().length <= 150" },
          "size": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 26214400" },
          "$other": { ".validate": false }
        }
      }
    },
    "reports": {
      ".write": "auth != null",
      ".read": false
    },
    "calls": {
      "$pair": { ".read": "auth != null && $pair.matches('^' + auth.uid + '_.*|.*_' + auth.uid + '$')", ".write": "auth != null" }
    },
    "inbox": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" }
    }
  }
}
