rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public room attachments: anyone signed into the app can read these.
    match /uploads/rooms/{roomId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }
    // Private attachments: only a UID included as one of the two DM pair members may read.
    match /uploads/dm/{pair}/{uid}/{fileName} {
      allow read: if request.auth != null
        && pair.matches('^' + request.auth.uid + '_.*|.*_' + request.auth.uid + '$');
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
